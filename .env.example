# =============================================================================
# NEARA Environment Variables — copy to .env and fill with real values.
# NEVER commit real secrets.
# =============================================================================

# ---- App ----
NODE_ENV=development
PORT=4000
APP_NAME=NEARA
APP_URL=http://localhost:4000
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ---- Database (MySQL) ----
DATABASE_URL="mysql://neara:neara_password@localhost:3306/neara"

# ---- Auth ----
JWT_SECRET=change_me_jwt_secret
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
OTP_TTL_MINUTES=10

# ---- Cloudinary (media storage) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Paystack (payments) ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co

# ---- Map provider (Google Maps / Mapbox abstraction) ----
MAP_PROVIDER=google
MAP_PROVIDER_KEY=

# ---- Notifications ----
EMAIL_PROVIDER=smtp
EMAIL_FROM=hello@neara.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=
SMS_API_KEY=

# ---- Push notifications ----
PUSH_NOTIFICATION_CONFIG=

# ---- Client-side (exposed to frontend) ----
VITE_API_URL=http://localhost:4000/api
VITE_MAP_PROVIDER_KEY=
VITE_PAYSTACK_PUBLIC_KEY=
EXPO_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_MAP_PROVIDER_KEY=
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=
