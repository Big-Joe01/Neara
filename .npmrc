# pnpm configuration — consistent across local, CI, and Vercel
auto-install-peers=true
strict-peer-dependencies=false
# Fallback for pnpm < 10.26 which does not support allowBuilds in pnpm-workspace.yaml
only-built-dependencies[]=prisma
only-built-dependencies[]=@prisma/client
only-built-dependencies[]=@prisma/engines
only-built-dependencies[]=esbuild
